{
  "manifest_version": 3,
  "name": "YouTube A–B Loop",
  "version": "1.0.0",
  "description": "Повтор выбранного фрагмента A–B прямо в плеере YouTube.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["loop-core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
